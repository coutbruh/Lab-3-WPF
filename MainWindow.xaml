<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
             Title="Список товаров" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="White">


    <Window.Resources>
        <!-- Стиль карточки товара -->
        <Style x:Key="ProductCardStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasBigDiscount}" Value="True">
                    <Setter Property="Background" Value="#C8A2C8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Шапка -->
            <RowDefinition Height="Auto"/>
            <!-- Поиск -->
            <RowDefinition Height="*"/>
            <!-- Список -->
        </Grid.RowDefinitions>

         <!-- Шапка --> 
        <Grid Grid.Row="0" Margin="10">
            <TextBlock Text="Список товаров"
                       FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding CurrentUserFullName}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,80,0"/>
            <Button Content="Выход" Width="70" Height="25"
                    HorizontalAlignment="Right"
                    Click="ExitButton_Click"/>
        </Grid>

        <!--Поиск-->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,10,10">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Width="400" Height="25"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"/>
        </StackPanel>

        <!--Список товаров-->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="10">
            <ItemsControl ItemsSource="{Binding FilteredProducts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ProductCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                 <!--Фото--> 
                                <Border Grid.Column="0" BorderBrush="Black" BorderThickness="1"
                    Width="140" Height="100">
                                    <Image Source="{Binding ImageFullPath, Mode=OneWay}" Stretch="Uniform"/>
                                </Border>

                                <!--Данные-->
                                <StackPanel Grid.Column="1" Margin="10,0">
                                    <TextBlock FontWeight="Bold">
                    <Run Text="{Binding CategoryName, Mode=OneWay}"/>
                    <Run Text=" | "/>
                    <Run Text="{Binding Article, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Description, Mode=OneWay, StringFormat='Описание товара: {0}'}"
                           TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding ManufacturerName, Mode=OneWay, StringFormat='Производитель: {0}'}"/>
                                    <TextBlock Text="{Binding SupplierName, Mode=OneWay, StringFormat='Поставщик: {0}'}"/>
                                    <TextBlock>
                    <Run Text="Цена: "/>
                    <Run Text="{Binding PriceWithDiscount, Mode=OneWay, StringFormat={}{0:N2}}"
                         Foreground="Red" FontWeight="Bold"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Count, Mode=OneWay, StringFormat='Количество на складе: {0}'}"/>
                                </StackPanel>

                                <!-- Скидка -->
                                <Border Grid.Column="2" BorderBrush="Black" BorderThickness="1" Margin="5">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Действующая" HorizontalAlignment="Center"/>
                                        <TextBlock Text="скидка" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Discount, Mode=OneWay, StringFormat='{}{0}%'}"
                               FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>